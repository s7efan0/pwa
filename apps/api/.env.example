# Copy this file to .env (same folder) and fill in the blanks.

# Postgres from docker-compose.yml — start it with `pnpm db:up`.
DATABASE_URL=postgresql://admin:admin123@localhost:5433/pwa_app

# TheSportsDB API key. "123" is the free public key.
THESPORTSDB_KEY=123

# Leagues that get fixtures, tables and statistics (TheSportsDB ids).
# 4328 = Premier League, 4331 = Bundesliga, 4480 = Champions League
# Live scores are shown for every league regardless.
TSDB_LEAGUE_IDS=4328,4331,4480
TSDB_SEASON=2025-2026

# Web Push keys. Generate a pair with:
#   pnpm --filter @livescore/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Password for the /api/admin import endpoint. Any random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_TOKEN=
